DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.example
DATABASE_URL=postgresql://user:password@host:5432/database
REDIS_URL=redis://host:6379/0
# Live classes. Leave as meet.jit.si (free, opens in its own tab). For a self-hosted Jitsi set your domain;
# it is then embedded in the page (JITSI_EMBED=true/false overrides).
JITSI_DOMAIN=meet.jit.si
RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
# Fallback NVIDIA key for the Tutor chat; normally set it in the admin panel under Tutor AI.
TUTOR_API_KEY=replace-with-nvidia-api-key
DROPBOX_APP_KEY=replace-with-dropbox-app-key
DROPBOX_APP_SECRET=replace-with-dropbox-app-secret
DROPBOX_REFRESH_TOKEN=replace-with-dropbox-refresh-token
SITE_URL=https://www.indoretutorials.online
# Leave unset (or False) in production. Set DJANGO_DEBUG=True only on your own computer.
DJANGO_DEBUG=False
# Permanent accounts (rnt@, admin@, student@gmail.com) are defined in base/apps.py; this setting is no longer used.
# DEFAULT_SUPERUSER_PASSWORD=
# Set to False only if the site is NOT behind a proxy that sets X-Forwarded-For.
TRUST_X_FORWARDED_FOR=True
